# Uploaded files are served as plain files only, never executed as scripts.
<FilesMatch "\.(php|phtml|phar|php\d|pl|py|cgi|sh|shtml)$">
    Require all denied
</FilesMatch>
<IfModule mod_php.c>
    php_flag engine off
</IfModule>
<IfModule mod_php7.c>
    php_flag engine off
</IfModule>
Options -ExecCGI -Indexes
